# Preserve existing credentials and database names on upgrades.
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=your_database_name
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_different_long_random_password
N8N_VERSION=2.47.5
N8N_IMAGE_NAME=btgunco-n8n:2.47.5-imagemagick
N8N_API_KEY=
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# false ONLY for local HTTP; use true with HTTPS for remote access.
N8N_SECURE_COOKIE=false
BIND_ADDRESS=127.0.0.1
WEB_IMAGES_HOST_DIR=/mnt/e/web_images
GENERIC_TIMEZONE=America/Chicago
NODE_OPTIONS=--max-old-space-size=4096
N8N_CONCURRENCY_PRODUCTION_LIMIT=2
N8N_PUSH_BACKEND=websocket
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
N8N_RUNNERS_ENABLED=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
# Audit workflows before allowing environment-variable access.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# For audited ImageMagick Execute Command workflows only, use:
# NODES_EXCLUDE='["n8n-nodes-base.localFileTrigger"]'
NODES_EXCLUDE='["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger"]'
# Generate with openssl rand -hex 32; never use the example as a real secret.
SEARXNG_SECRET=replace_with_a_random_secret
